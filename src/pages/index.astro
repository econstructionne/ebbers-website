---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import CtaBand from '../components/CtaBand.astro';

const facts = [
  { big: 'No wood in the ground', small: 'Posts on wet-set brackets in concrete piers' },
  { big: '12 in joist spacing', small: 'On every deck, whatever the decking' },
  { big: 'Full blueprint set', small: 'Drawn for every post frame building' },
  { big: 'Your own project portal', small: 'Proposal, invoices, photos and messages' },
];

const steps = [
  { title: 'Tell us your project', text: 'Design it in 3D or fill out the project planner.' },
  { title: 'Site visit', text: 'Cameron walks the site with you and brings samples.' },
  { title: 'Interactive proposal', text: 'Tick the options you want and watch the price update.' },
  { title: 'Sign online', text: 'Sign with your finger. Permits and materials get ordered.' },
  { title: 'Build and walkthrough', text: 'Follow progress and message us until the final walkthrough.' },
];
---
<Base
  title="Home"
  description="Family-owned builder in Firth, Nebraska. Post frame buildings, decks, custom homes, timber frame barns and remodels across Southeast Nebraska, built to a higher standard."
>
  <section class="hero">
    <img class="hero-photo" src="/photos/hero-shop-porch.jpg" alt="Dark steel post frame building with a covered porch, built by Ebbers Construction" fetchpriority="high" />
    <div class="hero-shade">
      <div class="wrap hero-inner">
        <div class="stack hero-copy">
          <h1 class="display">Built right the first time, and built to last.</h1>
          <p class="hero-lead">Post frame buildings, decks and custom homes from a small family crew that doesn't cut corners. We show you exactly how we build before you sign.</p>
          <div class="btn-row">
            <a href="/design" class="btn btn-light">Design your building in 3D</a>
            <a href="/post-frame" class="btn btn-outline-light">See how we build</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="band-white">
    <div class="wrap facts">
      {facts.map((f) => (
        <div class="fact">
          <span class="fact-big">{f.big}</span>
          <span class="small muted">{f.small}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap section" aria-labelledby="what-we-build">
    <div class="section-head">
      <h2 id="what-we-build" class="h2">What we build</h2>
      <p>Every project page shows the framing, materials and details we use, so you know what you're paying for.</p>
    </div>

    <article class="service split">
      <Photo src="/photos/shop-lawn.jpg" alt="Finished steel shop with three overhead doors" />
      <div class="stack">
        <span class="eyebrow">01 · Post frame</span>
        <h3 class="h3">Shops, garages and pole barns</h3>
        <p class="muted">Posts on concrete piers, 3-ply laminated columns 8 ft on center, a truss at every post, and stacked LVL headers over big doors.</p>
        <dl class="specs">
          <div><dt>Girts and purlins</dt><dd>2x6 and 2x4, at 24 in</dd></div>
          <div><dt>Bracing</dt><dd>Double X in every corner</dd></div>
        </dl>
        <div class="btn-row links">
          <a class="text-link" href="/post-frame">How we build post frame</a>
          <a class="text-link" href="/design">Design yours in 3D</a>
        </div>
      </div>
    </article>

    <article class="service split reverse">
      <div class="stack">
        <span class="eyebrow">02 · Decks</span>
        <h3 class="h3">Decks that stay flat and solid</h3>
        <p class="muted">TrueFrame kiln-dried joists at 12 in on center, taped tops, flashed ledgers, picture-frame borders and mitered stair treads.</p>
        <dl class="specs">
          <div><dt>Decking</dt><dd>Deckorators Voyage and Summit</dd></div>
          <div><dt>Railing</dt><dd>Westbury aluminum, 36 or 42 in</dd></div>
        </dl>
        <div class="btn-row links">
          <a class="text-link" href="/decks">How we build decks</a>
          <a class="text-link" href="/start?service=deck">Plan your deck</a>
        </div>
      </div>
      <Photo src="/photos/deck-dusk.jpg" alt="Two-level deck with black aluminum railing, lit up at dusk" />
    </article>

    <article class="service split">
      <Photo src="/photos/barn-remodel-after.jpg" alt="Old barn brought back with new red steel, a white roof and new overhead doors" />
      <div class="stack">
        <span class="eyebrow">03 · Homes, timber frame and remodels</span>
        <h3 class="h3">Custom homes and barns with character</h3>
        <p class="muted">From a new home to bringing an old barn back with custom soffit and trim, one crew handles it from start to finish.</p>
        <div class="btn-row links">
          <a class="text-link" href="/custom-homes">Custom homes</a>
          <a class="text-link" href="/timber-frame-remodels">Timber frame and remodels</a>
        </div>
      </div>
    </article>
  </section>

  <section class="band-white" aria-labelledby="process">
    <div class="wrap section">
      <div class="stack" style="margin-bottom: 40px;">
        <h2 id="process" class="h2">From first call to final walkthrough</h2>
        <p class="lead">You always know what's next. After you sign, everything lives in your own customer portal.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li><span class="num">STEP {i + 1}</span><strong>{s.title}</strong><span>{s.text}</span></li>
        ))}
      </ol>
      <p style="margin-top: 32px;"><a class="text-link" href="/how-we-work">More about how we work</a></p>
    </div>
  </section>

  <section class="wrap section split split-top">
    <figure class="quote">
      <blockquote>Customer review to come. A real quote from a past customer goes here, ideally one that talks about communication or quality.</blockquote>
      <figcaption class="muted">Customer name · Project and town</figcaption>
    </figure>
    <div class="stack lowest-bid">
      <h2 class="h3">We may not be the lowest bid.</h2>
      <p class="muted">We're a small, family-owned company. We don't cut corners, we tell you plainly what's in your price, and we care about building a relationship that lasts past the final walkthrough.</p>
      <a class="text-link" href="/about">About Cameron and Paul</a>
    </div>
  </section>

  <CtaBand title="Ready to plan your project?" text="The more you tell us up front, the more accurate your first quote will be." />
</Base>

<style>
  .hero { position: relative; min-height: min(78vh, 680px); display: flex; align-items: flex-end; background: #3a3d36; color: #fff; overflow: hidden; }
  .hero-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
  .hero-shade { position: relative; width: 100%; background: linear-gradient(to top, rgba(20, 22, 19, 0.9), rgba(20, 22, 19, 0)); }
  .hero-inner { padding-top: 180px; padding-bottom: 64px; }
  .hero-copy { max-width: 700px; --stack: 20px; }
  .hero-lead { font-size: clamp(17px, 1.8vw, 20px); line-height: 1.55; color: #e7e5de; }

  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .fact { padding: 26px 24px; display: flex; flex-direction: column; gap: 4px; border-left: 1px solid var(--line); }
  .fact:first-child { border-left: 0; padding-left: 0; }
  .fact-big { font-size: 20px; font-weight: 600; letter-spacing: -0.015em; }
  @media (max-width: 1040px) {
    .fact { border-left: 0; border-top: 1px solid var(--line); padding-left: 0; }
    .fact:first-child { border-top: 0; }
  }

  .service { padding: 44px 0; border-bottom: 1px solid var(--line-strong); }
  .service:last-of-type { border-bottom: 0; }
  .service .stack { --stack: 16px; }
  .links { gap: 24px; padding-top: 4px; }
  @media (max-width: 760px) {
    .service.reverse { display: flex; flex-direction: column-reverse; }
  }

  .quote { margin: 0; display: flex; flex-direction: column; gap: 20px; }
  .quote blockquote { margin: 0; font-size: clamp(22px, 2.6vw, 28px); line-height: 1.4; font-weight: 500; letter-spacing: -0.01em; }
  .lowest-bid { border-left: 1px solid var(--line-strong); padding-left: 32px; }
  @media (max-width: 760px) { .lowest-bid { border-left: 0; padding-left: 0; border-top: 1px solid var(--line-strong); padding-top: 28px; } }
</style>
