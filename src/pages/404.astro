---
import Base from '../layouts/Base.astro';
import PageIntro from '../components/PageIntro.astro';
import { site } from '../data/site';
---
<Base title="Page not found" description="This page could not be found." noindex>
  <PageIntro eyebrow="Page not found" title="We couldn't find that page.">
    <p>It may have moved when we rebuilt our website. Try the home page, or call <a href={site.phoneHref}>{site.phone}</a>.</p>
    <div class="btn-row"><a href="/" class="btn btn-primary">Go to the home page</a></div>
  </PageIntro>
  <div style="height: 64px;"></div>
</Base>
