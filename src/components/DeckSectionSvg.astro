---
/** Side section of an Ebbers deck, house to railing. Numbers match the parts list on the decks page. */
const marks = [
  { n: 1, x: 112, y: 104, to: 'M100 112L76 140' },
  { n: 2, x: 262, y: 100, to: 'M262 113V144' },
  { n: 3, x: 352, y: 214, to: 'M365 214H398' },
  { n: 4, x: 486, y: 300, to: 'M473 300H432' },
  { n: 5, x: 566, y: 150, to: 'M553 148H530' },
  { n: 6, x: 572, y: 40, to: 'M559 44L542 54' },
];
const boards = [74, 132, 190, 248, 306, 364, 422, 480];
---
<svg viewBox="0 0 600 420" role="img" aria-labelledby="deck-title" fill="none" stroke="#1d1f1b" stroke-width="1.5" stroke-linejoin="round">
  <title id="deck-title">Side section of an Ebbers deck from the house wall to the railing, with six numbered parts</title>
  <!-- house wall with siding lines -->
  <rect x="20" y="30" width="36" height="330" fill="#e9e6de" />
  <path d="M20 60H56M20 90H56M20 120H56M20 210H56M20 240H56M20 270H56M20 300H56M20 330H56" stroke="#b9b6ac" stroke-width="1" />
  <!-- ledger and flashing -->
  <rect x="56" y="152" width="18" height="40" fill="#e8dcc4" />
  <path d="M50 118V146H80V156" stroke="#4e6446" stroke-width="3" />
  <!-- joist with joist tape -->
  <rect x="74" y="152" width="430" height="36" fill="#e8dcc4" />
  <path d="M74 152H504" stroke="#4e6446" stroke-width="3" />
  <!-- rim joist -->
  <rect x="504" y="152" width="12" height="40" fill="#e8dcc4" />
  <!-- decking boards and picture-frame border -->
  {boards.map((x) => <rect x={x} y="140" width="56" height="10" fill="#9c9183" stroke-width="1" />)}
  <rect x="496" y="140" width="34" height="10" fill="#3d403a" stroke-width="1" />
  <!-- beam, post and footing -->
  <rect x="398" y="188" width="44" height="48" fill="#e8dcc4" />
  <rect x="410" y="236" width="20" height="124" fill="#e8dcc4" />
  <path d="M20 360H590" stroke-width="1" />
  <rect x="394" y="360" width="52" height="48" fill="#d6d3ca" />
  <path d="M402 372l10 10M422 380l10 10M410 394l10 10" stroke="#6b6e66" stroke-width="1" />
  <!-- railing post, top rail and drink rail -->
  <rect x="510" y="62" width="10" height="78" fill="#2a2c28" stroke="none" />
  <rect x="500" y="54" width="44" height="8" fill="#9c9183" stroke-width="1" />
  <path d="M515 66V140" stroke="#2a2c28" stroke-width="2" />
  <!-- callouts -->
  {marks.map((m) => (
    <g>
      <path d={m.to} stroke="#1d1f1b" stroke-width="1" />
      <circle cx={m.x} cy={m.y} r="13" fill="#1d1f1b" stroke="none" />
      <text x={m.x} y={m.y + 5} text-anchor="middle" fill="#fff" stroke="none" font-size="13" font-weight="500" font-family="var(--mono)">{m.n}</text>
    </g>
  ))}
</svg>
