---
import { site } from '../data/site';

interface Props {
  title: string;
  text: string;
  primaryHref?: string;
  primaryLabel?: string;
}
const { title, text, primaryHref = '/start', primaryLabel = 'Start your project' } = Astro.props;
---
<section class="band-green">
  <div class="wrap cta">
    <div class="stack" style="--stack: 8px; max-width: 640px;">
      <h2 class="h2">{title}</h2>
      <p class="cta-text">{text}</p>
    </div>
    <div class="btn-row">
      <a href={primaryHref} class="btn btn-light">{primaryLabel}</a>
      <a href={site.phoneHref} class="btn btn-outline-light">Call {site.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 28px; padding-top: 64px; padding-bottom: 64px; }
  .cta-text { color: var(--green-tint); font-size: 17px; }
</style>
