---
/** A numbered drawing on the left and the matching numbered parts list on the right. */
interface Part { title: string; text: string }
interface Props {
  label: string;
  parts: Part[];
}
const { label, parts } = Astro.props;
---
<div class="drawing-card">
  <figure class="drawing">
    <figcaption class="mono drawing-label">{label}</figcaption>
    <slot />
  </figure>
  <ol class="parts">
    {parts.map((p, i) => (
      <li>
        <span class="mono part-num" aria-hidden="true">{i + 1}</span>
        <span class="part-body"><strong>{p.title}</strong><span>{p.text}</span></span>
      </li>
    ))}
  </ol>
</div>

<style>
  .drawing-card {
    background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-card); overflow: hidden;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
  }
  .drawing { margin: 0; padding: 28px; background: var(--paper-2); border-right: 1px solid var(--line); display: flex; flex-direction: column; gap: 12px; }
  .drawing :global(svg) { width: 100%; height: auto; }
  .drawing-label { font-size: 12px; letter-spacing: 0.06em; color: var(--ink-2); }
  .parts { list-style: none; margin: 0; padding: 20px 32px; counter-reset: none; }
  .parts li { display: grid; grid-template-columns: 34px 1fr; gap: 10px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .parts li:last-child { border-bottom: 0; }
  .part-num {
    width: 26px; height: 26px; border-radius: 50%; background: var(--ink); color: #fff;
    display: inline-flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 500;
  }
  .part-body { display: flex; flex-direction: column; gap: 3px; }
  .part-body strong { font-size: 16px; }
  .part-body span { font-size: 15px; line-height: 1.5; color: var(--ink-2); }
  @media (max-width: 640px) {
    .drawing { border-right: 0; border-bottom: 1px solid var(--line); padding: 18px; }
    .parts { padding: 8px 18px; }
  }
</style>
